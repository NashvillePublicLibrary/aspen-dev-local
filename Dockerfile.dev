# Dockerfile.dev
# Extends the main Aspen image with dev-only tooling.

FROM aspen-dev-local-base

ARG ORACLE_IC_DIR=instantclient_23_26

RUN apt-get update \
    && apt-get install -y \
        php8.4-xdebug \
        php8.4-dev \
        php-pear \
        build-essential \
        libaio1 \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/*

# Install latest Oracle Instant Client Basic + SDK
RUN mkdir -p /opt/oracle \
    && cd /tmp \
    && wget \
        "https://download.oracle.com/otn_software/linux/instantclient/instantclient-basic-linuxx64.zip" \
        -O instantclient-basic.zip \
    && wget \
        "https://download.oracle.com/otn_software/linux/instantclient/instantclient-sdk-linuxx64.zip" \
        -O instantclient-sdk.zip \
    && unzip -o instantclient-basic.zip -d /opt/oracle \
    && unzip -o instantclient-sdk.zip -d /opt/oracle \
    && rm -f instantclient-basic.zip instantclient-sdk.zip

# Make Oracle libraries available to the dynamic linker
RUN echo "/opt/oracle/${ORACLE_IC_DIR}" \
        > /etc/ld.so.conf.d/oracle-instantclient.conf \
    && ldconfig

# Compile and enable PHP OCI8
RUN printf "instantclient,/opt/oracle/${ORACLE_IC_DIR}\n" \
        | pecl install oci8 \
    && echo "extension=oci8.so" \
        > /etc/php/8.4/mods-available/oci8.ini \
    && phpenmod oci8
